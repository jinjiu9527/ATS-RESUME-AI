# ============================================
# resumeai - 环境变量配置模板
# 复制此文件为 .env.local 并填入实际值
# ============================================

# ---------- DeepSeek AI ----------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# ---------- Clerk 认证 ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/resume
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/resume

# ---------- Supabase 数据库 ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxx

# ---------- Lemon Squeezy 支付 ----------
# 从 Lemon Squeezy 后台 Settings > API 获取
LEMON_SQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...
# 从 Store 页面获取数字 ID
LEMON_SQUEEZY_STORE_ID=12345
# 从 Product > Variants 获取数字 ID
LEMON_SQUEEZY_PRO_VARIANT_ID=12345
# 从 Settings > Webhooks 获取 Signing Secret
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret

# ---------- 应用 URL (Vercel 自动注入，本地需手动设置) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
